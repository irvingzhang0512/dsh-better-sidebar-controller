{
  "name": "dsh-better-sidebar-controller",
  "version": "0.3.1",
  "description": "better-sidebar 的模型控制增强扩展：打开文件、文件夹与网页，按侧边卡片开关管理工具，同步原生文件状态。",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/irvingzhang0512/dsh-better-sidebar-controller.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "src",
    "skills",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && node -e \"require('node:fs').rmSync('lib/client',{recursive:true,force:true})\" && tsdown -c tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "controller",
    "file-tree",
    "agent-tools",
    "skill"
  ],
  "license": "MIT",
  "dependencies": {
    "ws": "8.22.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "dsh-better-sidebar": "0.28.0",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/ws": "8.18.2",
    "dsh-better-sidebar": "0.28.0",
    "tsdown": "0.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.2",
    "react": "18.3.1",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2"
  }
}
